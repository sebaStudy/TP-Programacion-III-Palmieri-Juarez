<%# Formulario de nuevo administrador. Variables: datos (lo que se había escrito), errores %>
<%- include('../partials/head') %>
<%- include('../partials/header') %>
<% const errorDe = (campo) => errores.find((e) => e.campo === campo); %>

<main>
  <h1>Nuevo administrador</h1>

  <% if (errores.length > 0) { %>
    <div class="alerta" role="alert">Revisá los campos marcados antes de guardar.</div>
  <% } %>

  <form class="formulario" method="POST" action="/admin/users" novalidate>
    <label for="nombre">Nombre</label>
    <input type="text" id="nombre" name="nombre" maxlength="255" value="<%= datos.nombre ?? '' %>">
    <% if (errorDe('nombre')) { %><small class="error"><%= errorDe('nombre').mensaje %></small><% } %>

    <label for="email">Correo</label>
    <input type="email" id="email" name="email" maxlength="255" autocomplete="off" value="<%= datos.email ?? '' %>">
    <% if (errorDe('email')) { %><small class="error"><%= errorDe('email').mensaje %></small><% } %>

    <label for="password">Contraseña</label>
    <input type="password" id="password" name="password" autocomplete="new-password">
    <small class="ayuda">Entre 8 y 72 caracteres. Se guarda encriptada.</small>
    <% if (errorDe('password')) { %><small class="error"><%= errorDe('password').mensaje %></small><% } %>

    <div class="acciones">
      <button type="submit" class="boton">Crear administrador</button>
      <a class="boton boton-secundario" href="/admin/dashboard">Cancelar</a>
    </div>
  </form>
</main>

<%- include('../partials/footer') %>
