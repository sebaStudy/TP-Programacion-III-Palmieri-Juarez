<%# Pantalla de login. Variables: email (lo que se escribió), errores, acceso (datos del administrador de prueba) %>
<%- include('../partials/head') %>
<%- include('../partials/header') %>
<% const errorDe = (campo) => errores.find((e) => e.campo === campo); %>

<main class="pagina-login">
  <h1>Ingresar al panel</h1>

  <form class="formulario" method="POST" action="/admin/login" novalidate>
    <% if (errorDe('general')) { %>
      <div class="alerta" role="alert"><%= errorDe('general').mensaje %></div>
    <% } %>

    <label for="email">Correo</label>
    <input type="email" id="email" name="email" autocomplete="username" value="<%= email %>">
    <% if (errorDe('email')) { %><small class="error"><%= errorDe('email').mensaje %></small><% } %>

    <label for="password">Contraseña</label>
    <input type="password" id="password" name="password" autocomplete="current-password">
    <% if (errorDe('password')) { %><small class="error"><%= errorDe('password').mensaje %></small><% } %>

    <button type="submit" class="boton">Ingresar</button>

    <%# Acceso rápido para los testers: solo completa los campos, después se toca "Ingresar" %>
    <button type="button" class="boton boton-secundario" id="acceso-rapido"
      data-email="<%= acceso.email %>" data-password="<%= acceso.password %>">Acceso rápido</button>
  </form>
</main>

<script src="/js/login.js"></script>

<%- include('../partials/footer') %>
